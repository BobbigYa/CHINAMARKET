<Window x:Class="Tpos.Desktop.MainWindow"
        AutomationProperties.AutomationId="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tpos.Desktop.Views"
        xmlns:viewModels="clr-namespace:Tpos.Desktop.ViewModels"
        Title="TPOS^"
        Width="440" Height="540"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#050D16"
        Foreground="#F7F8FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:AuthenticationViewModel}">
            <views:AuthenticationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#071119" BorderBrush="#203843" BorderThickness="0,0,0,1">
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="MinimizeWindowButton" Style="{StaticResource IconButtonStyle}" Width="44" Height="46" Click="Minimize_OnClick" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" />
                    <Button AutomationProperties.AutomationId="MaximizeWindowButton" Style="{StaticResource IconButtonStyle}" Width="44" Height="46" Click="Maximize_OnClick" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" />
                    <Button AutomationProperties.AutomationId="CloseWindowButton" Style="{StaticResource IconButtonStyle}" Width="44" Height="46" Click="Close_OnClick" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" />
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl x:Name="PageContent" Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
