<UserControl x:Class="Tpos.Desktop.Controls.LanguageSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="3" CornerRadius="8" BorderThickness="1" BorderBrush="#17FFFFFF" Background="#1F000000">
        <StackPanel Orientation="Horizontal">
            <Button Content="简体中文"
                    Command="{Binding Source={StaticResource Loc}, Path=SetLanguageCommand}"
                    CommandParameter="zh">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LanguageButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={StaticResource Loc}, Path=Language}" Value="zh">
                                <Setter Property="Background" Value="#24D9BA84" />
                                <Setter Property="Foreground" Value="#F7E5C3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="ES"
                    Command="{Binding Source={StaticResource Loc}, Path=SetLanguageCommand}"
                    CommandParameter="es">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LanguageButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={StaticResource Loc}, Path=Language}" Value="es">
                                <Setter Property="Background" Value="#24D9BA84" />
                                <Setter Property="Foreground" Value="#F7E5C3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
