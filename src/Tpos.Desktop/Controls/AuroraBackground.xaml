<UserControl x:Class="Tpos.Desktop.Controls.AuroraBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <Storyboard x:Key="DriftOne" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbOne" Storyboard.TargetProperty="RenderTransform.X" From="-18" To="90" Duration="0:0:22" />
            <DoubleAnimation Storyboard.TargetName="OrbOne" Storyboard.TargetProperty="RenderTransform.Y" From="-10" To="55" Duration="0:0:22" />
        </Storyboard>
        <Storyboard x:Key="DriftTwo" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbTwo" Storyboard.TargetProperty="RenderTransform.X" From="30" To="-85" Duration="0:0:26" />
            <DoubleAnimation Storyboard.TargetName="OrbTwo" Storyboard.TargetProperty="RenderTransform.Y" From="20" To="-48" Duration="0:0:26" />
        </Storyboard>
        <Storyboard x:Key="DriftThree" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbThree" Storyboard.TargetProperty="RenderTransform.X" From="-30" To="70" Duration="0:0:20" />
            <DoubleAnimation Storyboard.TargetName="OrbThree" Storyboard.TargetProperty="Opacity" From="0.45" To="0.85" Duration="0:0:20" />
        </Storyboard>
    </UserControl.Resources>
    <Grid ClipToBounds="True" Background="Transparent">
        <Ellipse x:Name="OrbOne" Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-270,-290,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#85307981" Offset="0" />
                    <GradientStop Color="#38184C58" Offset="0.42" />
                    <GradientStop Color="#00184C58" Offset="0.72" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbTwo" Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-330,-400">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#595B487F" Offset="0" />
                    <GradientStop Color="#242F2A55" Offset="0.45" />
                    <GradientStop Color="#002F2A55" Offset="0.72" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbThree" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-350" Opacity="0.55">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#29C19755" Offset="0" />
                    <GradientStop Color="#00C19755" Offset="0.7" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
