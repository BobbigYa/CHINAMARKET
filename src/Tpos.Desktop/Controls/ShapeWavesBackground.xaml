<UserControl x:Class="Tpos.Desktop.Controls.ShapeWavesBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="ShapeWavesBackground">
    <Grid Background="#00050D">
        <Canvas x:Name="ContourCanvas" IsHitTestVisible="False" />
        <Canvas x:Name="WaveCanvas" Background="Transparent" />
    </Grid>
</UserControl>
