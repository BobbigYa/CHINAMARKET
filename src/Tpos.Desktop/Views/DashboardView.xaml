<UserControl x:Class="Tpos.Desktop.Views.DashboardView"
             AutomationProperties.AutomationId="DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tpos.Desktop.Controls">
    <Grid Background="#0E1B25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0A151E" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,26,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="45" Height="45" CornerRadius="14" Background="#D9BA84">
                            <TextBlock Text="T" Foreground="#142029" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TPOS^" Foreground="#F7F8FA" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="RETAIL WORKSPACE" Foreground="#758792" FontSize="7" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Navigation]}" Foreground="#667984" FontSize="10" FontWeight="SemiBold" Margin="5,42,0,12" />
                    <Button Style="{StaticResource NavigationButtonStyle}" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,1 L5,1 L5,5 L1,5 Z M7,1 L11,1 L11,5 L7,5 Z M1,7 L5,7 L5,11 L1,11 Z M7,7 L11,7 L11,11 L7,11 Z" Stroke="#E8CD9B" StrokeThickness="1" Width="15" Height="15" Stretch="Uniform" />
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Dashboard]}" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="20,0,20,22" Padding="12" CornerRadius="9" Background="#0CFFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#80C7A5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[OfflineMode]}" Foreground="#9FB3A9" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Dashboard]}" Foreground="#F5F7F9" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Overview]}" Foreground="#7F919C" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <controls:LanguageSelector VerticalAlignment="Center" />
                    <Button AutomationProperties.AutomationId="LogoutButton" Command="{Binding LogoutCommand}" Style="{StaticResource TextButtonStyle}" Margin="18,0,0,0" Padding="12,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5,1 L1,1 L1,11 L5,11 M8,3 L11,6 L8,9 M3,6 L11,6" Stroke="#AAB8C1" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Logout]}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,30,0,0">
                <Border Padding="36" CornerRadius="16" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="15" Background="#1AD9BA84" HorizontalAlignment="Left">
                            <Path Data="M6,2 L1,4 L1,7 C1,11 3,14 6,16 C9,14 11,11 11,7 L11,4 Z M4,8 L5.5,9.5 L8.5,6" Stroke="#E8CD9B" StrokeThickness="1.2" Width="24" Height="24" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[DashboardWelcome]}" Foreground="#F5F7F9" FontSize="31" FontWeight="SemiBold" Margin="0,25,0,0" />
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[DashboardMessage]}" Foreground="#A8B6C0" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Border Height="1" Background="#13FFFFFF" Margin="0,28,0,24" />
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ReadyTitle]}" Foreground="#E5CDA3" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ReadyMessage]}" Foreground="#8FA0AB" FontSize="13" LineHeight="23" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="650" />
                        <Border Margin="0,24,0,0" Padding="12,8" CornerRadius="7" Background="#122D8B68" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#87D8B2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SessionVerified]}" Foreground="#A6E9D2" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
