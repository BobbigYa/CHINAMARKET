<UserControl x:Class="Tpos.Desktop.Views.LoginView"
             AutomationProperties.AutomationId="LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="CardIn">
            <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="RenderTransform.Y" From="12" To="0" Duration="0:0:0.4" />
        </Storyboard>
    </UserControl.Resources>
    <Border x:Name="LoginCard"
            Width="330"
            Padding="18,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TranslateTransform Y="12" /></Border.RenderTransform>
        <StackPanel>
            <Grid Margin="0,4,0,0">
                <PasswordBox x:Name="PasswordInput"
                             AutomationProperties.AutomationId="LoginPassword"
                             AutomationProperties.Name="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}"
                             ToolTip="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             IsEnabled="{Binding IsInputEnabled}"
                             PreviewKeyDown="Password_OnPreviewKeyDown"
                             PasswordChar="•" />
                <TextBox x:Name="VisiblePasswordInput"
                         AutomationProperties.AutomationId="LoginVisiblePassword"
                         AutomationProperties.Name="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}"
                         Style="{StaticResource LoginTextBoxStyle}"
                         IsEnabled="{Binding IsInputEnabled}"
                         Visibility="Collapsed"
                         PreviewKeyDown="Password_OnPreviewKeyDown" />
                <Button x:Name="RevealPasswordButton"
                        AutomationProperties.AutomationId="RevealPasswordButton"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        Click="RevealPassword_OnClick"
                        IsEnabled="{Binding IsInputEnabled}">
                    <Grid Width="19" Height="19">
                        <Path x:Name="EyeOpen" Data="M1,8 C3,3 13,3 15,8 C13,13 3,13 1,8 Z M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5" Stroke="#A8B6C0" StrokeThickness="1.1" Stretch="Uniform" />
                        <Path x:Name="EyeClosed" Data="M1,1 L15,15 M3,4 C2,5 1,7 1,8 C3,13 13,13 15,8 C14,6 13,5 12,4 M5,6 C6,10 10,11 12,8" Stroke="#A8B6C0" StrokeThickness="1.1" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                </Button>
            </Grid>

            <Border Margin="0,12,0,0"
                    Padding="10,8"
                    CornerRadius="9"
                    BorderThickness="1"
                    Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#33FF8E85" />
                        <Setter Property="Background" Value="#2C972D2B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                <Setter Property="Background" Value="#2C2D8B68" />
                                <Setter Property="BorderBrush" Value="#3387D8B2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="LoginMessage"
                               Text="{Binding Message}"
                               FontSize="11"
                               LineHeight="17"
                               TextWrapping="Wrap"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFB4AB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True"><Setter Property="Foreground" Value="#A6E9D2" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding LockRemainingText}"
                               Foreground="#FFD0CA"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,3,0,0"
                               Visibility="{Binding HasLockRemaining, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Border>

            <ProgressBar Height="3"
                         Margin="10,7,10,0"
                         Minimum="0" Maximum="100"
                         IsIndeterminate="True"
                         Foreground="#D9BA84"
                         Background="Transparent"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            <Button AutomationProperties.AutomationId="ChangePasswordButton"
                    Style="{StaticResource TextButtonStyle}"
                    Content="{Binding Source={StaticResource Loc}, Path=[ChangePassword]}"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Click="ChangePassword_OnClick"
                    IsEnabled="{Binding IsInputEnabled}" />
        </StackPanel>
    </Border>
</UserControl>
