<UserControl x:Class="Tpos.Desktop.Views.LoginView"
             AutomationProperties.AutomationId="LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Top">
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[EmailAddress]}"
                   Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,7" />
        <TextBox x:Name="EmailInput"
                 AutomationProperties.AutomationId="LoginEmail"
                 AutomationProperties.Name="{Binding Source={StaticResource Loc}, Path=[EmailAddress]}"
                 Style="{StaticResource EmailTextBoxStyle}"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsInputEnabled}"
                 InputMethod.IsInputMethodEnabled="False"
                 MaxLength="254" />

        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}"
                   Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold" Margin="2,15,0,7" />
        <Grid>
            <PasswordBox x:Name="PasswordInput"
                         AutomationProperties.AutomationId="LoginPassword"
                         AutomationProperties.Name="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}"
                         Style="{StaticResource LoginPasswordBoxStyle}"
                         IsEnabled="{Binding IsInputEnabled}"
                         PreviewKeyDown="Password_OnPreviewKeyDown"
                         PasswordChar="•" />
            <TextBox x:Name="VisiblePasswordInput"
                     AutomationProperties.AutomationId="LoginVisiblePassword"
                     AutomationProperties.Name="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}"
                     Style="{StaticResource LoginTextBoxStyle}"
                     IsEnabled="{Binding IsInputEnabled}"
                     Visibility="Collapsed"
                     PreviewKeyDown="Password_OnPreviewKeyDown" />
            <Button x:Name="RevealPasswordButton"
                    AutomationProperties.AutomationId="RevealPasswordButton"
                    Style="{StaticResource IconButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"
                    Click="RevealPassword_OnClick"
                    IsEnabled="{Binding IsInputEnabled}">
                <Grid Width="19" Height="19">
                    <Path x:Name="EyeOpen" Data="M1,8 C3,3 13,3 15,8 C13,13 3,13 1,8 Z M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5" Stroke="#A8B6C0" StrokeThickness="1.1" Stretch="Uniform" />
                    <Path x:Name="EyeClosed" Data="M1,1 L15,15 M3,4 C2,5 1,7 1,8 C3,13 13,13 15,8 C14,6 13,5 12,4 M5,6 C6,10 10,11 12,8" Stroke="#A8B6C0" StrokeThickness="1.1" Stretch="Uniform" Visibility="Collapsed" />
                </Grid>
            </Button>
        </Grid>

        <Button AutomationProperties.AutomationId="LoginSubmitButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Content="{Binding SubmitText}"
                Margin="0,19,0,0"
                IsDefault="True"
                Click="Login_OnClick"
                IsEnabled="{Binding IsInputEnabled}" />

        <StackPanel Margin="4,10,4,0"
                    Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock AutomationProperties.AutomationId="LoginMessage"
                       Text="{Binding Message}"
                       FontSize="11"
                       LineHeight="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFB4AB" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                <Setter Property="Foreground" Value="#A6E9D2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding LockRemainingText}"
                       Foreground="#FFD0CA"
                       FontSize="11"
                       TextAlignment="Center"
                       Visibility="{Binding HasLockRemaining, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
