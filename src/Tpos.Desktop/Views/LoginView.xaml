<UserControl x:Class="Tpos.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tpos.Desktop.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <Storyboard x:Key="CardIn">
            <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="RenderTransform.Y" From="12" To="0" Duration="0:0:0.4" />
        </Storyboard>
    </UserControl.Resources>
    <Border x:Name="LoginCard" Style="{StaticResource CardBorderStyle}" MaxWidth="408" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><TranslateTransform Y="12" /></Border.RenderTransform>
        <StackPanel>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path Data="M6,1 L1,3.5 L1,7 C1,10 3,13 6,15 C9,13 11,10 11,7 L11,3.5 Z M4,7.5 L5.5,9 L8.5,5.5" Stroke="#D9BA84" StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LocalAccess]}" Foreground="#B8C7CE" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <controls:LanguageSelector DockPanel.Dock="Right" />
            </DockPanel>

            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Welcome]}" Foreground="#F7F8FA" FontSize="27" FontWeight="SemiBold" Margin="0,29,0,0" />
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LoginInstruction]}" Foreground="#A1AFB9" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,9,0,0" />
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[AdminPassword]}" Foreground="#D8DFE3" FontSize="12" FontWeight="SemiBold" Margin="0,25,0,9" />

            <Grid>
                <PasswordBox x:Name="PasswordInput"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             IsEnabled="{Binding IsInputEnabled}"
                             PreviewKeyDown="Password_OnPreviewKeyDown"
                             PasswordChar="•" />
                <TextBox x:Name="VisiblePasswordInput"
                         Style="{StaticResource LoginTextBoxStyle}"
                         IsEnabled="{Binding IsInputEnabled}"
                         Visibility="Collapsed"
                         PreviewKeyDown="Password_OnPreviewKeyDown" />
                <Button x:Name="RevealPasswordButton"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        Click="RevealPassword_OnClick"
                        IsEnabled="{Binding IsInputEnabled}">
                    <Grid Width="19" Height="19">
                        <Path x:Name="EyeOpen" Data="M1,8 C3,3 13,3 15,8 C13,13 3,13 1,8 Z M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5" Stroke="#91A0AA" StrokeThickness="1.1" Stretch="Uniform" />
                        <Path x:Name="EyeClosed" Data="M1,1 L15,15 M3,4 C2,5 1,7 1,8 C3,13 13,13 15,8 C14,6 13,5 12,4 M5,6 C6,10 10,11 12,8" Stroke="#91A0AA" StrokeThickness="1.1" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                </Button>
            </Grid>

            <Border Margin="0,13,0,0" Padding="11" CornerRadius="9" BorderThickness="1" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#33FF8E85" />
                        <Setter Property="Background" Value="#1C972D2B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                <Setter Property="Background" Value="#1C2D8B68" />
                                <Setter Property="BorderBrush" Value="#3387D8B2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Message}" FontSize="11" LineHeight="18" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFB4AB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True"><Setter Property="Foreground" Value="#A6E9D2" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding LockRemainingText}" Foreground="#FFD0CA" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="{Binding HasLockRemaining, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SubmitText}" Margin="0,19,0,0" Click="Login_OnClick" IsEnabled="{Binding IsInputEnabled}" />
            <ProgressBar Height="3" Margin="10,5,10,0" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="#D9BA84" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            <Button Style="{StaticResource TextButtonStyle}" Content="{Binding Source={StaticResource Loc}, Path=[ChangePassword]}" Margin="0,11,0,0" HorizontalAlignment="Center" Click="ChangePassword_OnClick" IsEnabled="{Binding IsInputEnabled}" />

            <Border BorderThickness="0,1,0,0" BorderBrush="#13FFFFFF" Margin="0,18,0,0" Padding="0,16,0,0">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[PrivacyNote]}" Foreground="#758792" FontSize="10" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
