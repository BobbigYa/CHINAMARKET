<UserControl x:Class="Tpos.Desktop.Views.SetupView"
             AutomationProperties.AutomationId="SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Top">
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SetupTitle]}"
                   Foreground="#F7F8FA" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SetupInstruction]}"
                   Foreground="#A1AFB9" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,7,0,16" />

        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[EmailAddress]}"
                   Foreground="#E5E7EB" FontSize="12" Margin="2,0,0,6" />
        <TextBox x:Name="EmailInput"
                 AutomationProperties.AutomationId="SetupEmail"
                 Style="{StaticResource EmailTextBoxStyle}"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsInputEnabled}"
                 MaxLength="254" />

        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[NewPassword]}"
                   Foreground="#E5E7EB" FontSize="12" Margin="2,12,0,6" />
        <PasswordBox x:Name="NewPasswordInput"
                     AutomationProperties.AutomationId="SetupNewPassword"
                     Style="{StaticResource LoginPasswordBoxStyle}"
                     IsEnabled="{Binding IsInputEnabled}"
                     PasswordChar="•" />

        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ConfirmPassword]}"
                   Foreground="#E5E7EB" FontSize="12" Margin="2,12,0,6" />
        <PasswordBox x:Name="ConfirmationInput"
                     AutomationProperties.AutomationId="SetupPasswordConfirmation"
                     Style="{StaticResource LoginPasswordBoxStyle}"
                     IsEnabled="{Binding IsInputEnabled}"
                     PasswordChar="•"
                     PreviewKeyDown="Confirmation_OnPreviewKeyDown" />

        <TextBlock AutomationProperties.AutomationId="SetupMessage"
                   Text="{Binding ErrorMessage}"
                   Foreground="#FFB4AB" FontSize="11" LineHeight="16" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="4,9,4,0"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />
        <Button AutomationProperties.AutomationId="SetupSubmitButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Content="{Binding SubmitText}"
                Margin="0,15,0,0"
                Click="Initialize_OnClick"
                IsEnabled="{Binding IsInputEnabled}" />
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SetupSecurityNote]}"
                   Foreground="#8798A2" FontSize="10" LineHeight="15" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="8,13,8,0" />
    </StackPanel>
</UserControl>
