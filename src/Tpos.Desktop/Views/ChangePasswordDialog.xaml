<Window x:Class="Tpos.Desktop.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={StaticResource Loc}, Path=[ChangePasswordTitle]}"
        Width="450" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#10202B"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI">
    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ChangePasswordTitle]}" Foreground="#F7F8FA" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[SetupSecurityNote]}" Foreground="#9CAAB6" FontSize="11" LineHeight="18" TextWrapping="Wrap" Margin="0,10,0,22" />
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[CurrentPassword]}" Foreground="#D8DFE3" FontSize="12" Margin="0,0,0,8" />
            <PasswordBox x:Name="CurrentPasswordInput" Style="{StaticResource LoginPasswordBoxStyle}" IsEnabled="{Binding IsInputEnabled}" PasswordChar="•" />
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[NewPassword]}" Foreground="#D8DFE3" FontSize="12" Margin="0,15,0,8" />
            <PasswordBox x:Name="NewPasswordInput" Style="{StaticResource LoginPasswordBoxStyle}" IsEnabled="{Binding IsInputEnabled}" PasswordChar="•" />
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[ConfirmPassword]}" Foreground="#D8DFE3" FontSize="12" Margin="0,15,0,8" />
            <PasswordBox x:Name="ConfirmationInput" Style="{StaticResource LoginPasswordBoxStyle}" IsEnabled="{Binding IsInputEnabled}" PasswordChar="•" />
            <Border Margin="0,13,0,0" Padding="11" CornerRadius="9" BorderThickness="1" BorderBrush="#33FF8E85" Background="#1C972D2B" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB4AB" FontSize="11" LineHeight="18" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Cancel]}" Style="{StaticResource TextButtonStyle}" Padding="15,9" Margin="0,0,10,0" Click="Cancel_OnClick" IsEnabled="{Binding IsInputEnabled}" />
                <Button Content="{Binding Source={StaticResource Loc}, Path=[ConfirmChange]}" Style="{StaticResource PrimaryButtonStyle}" Height="43" Padding="20,0" Click="Confirm_OnClick" IsEnabled="{Binding IsInputEnabled}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
