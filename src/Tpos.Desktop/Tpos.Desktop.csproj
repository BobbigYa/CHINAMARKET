    <UseWPF>true</UseWPF>
    <RootNamespace>Tpos.Desktop</RootNamespace>
    <AssemblyName>Tpos.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TposLogo.ico</ApplicationIcon>
